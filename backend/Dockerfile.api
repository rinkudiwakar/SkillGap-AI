FROM python:3.11-slim AS builder

WORKDIR /build

COPY backend/requirements-api-docker.txt .

RUN pip install --no-cache-dir --user -r requirements-api-docker.txt

FROM python:3.11-slim

WORKDIR /app

COPY --from=builder /root/.local /root/.local

ENV PATH=/root/.local/bin:$PATH \
  PYTHONUNBUFFERED=1 \
  PYTHONDONTWRITEBYTECODE=1

ENV PYTHONPATH=/app:/app/ai

COPY backend/fastapi_app /app/fastapi_app
COPY ai/src /app/ai/src
COPY ai/prompts /app/ai/prompts
COPY ai/params.yaml /app/ai/params.yaml
COPY ai/skill_expansion_cleaned.json /app/ai/skill_expansion_cleaned.json

RUN mkdir -p /app/uploads /app/logs

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=5)" || exit 1

CMD ["uvicorn", "fastapi_app.main:app", "--host", "0.0.0.0", "--port", "8000"]
