# SkillGap AI Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ===== LLM PROVIDERS (PRIMARY & FALLBACK) =====
# Groq (PRIMARY)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Together AI (FALLBACK)
# Get key from: https://api.together.xyz/
TOGETHER_API_KEY=your_together_api_key_here

# Legacy providers (deprecated - no longer used)
# OPENAI_API_KEY=sk_...
# GEMINI_API_KEY=...

# GitHub Models (legacy)
# GITHUB_PAT=github_pat_...
# GITHUB_MODELS_API_URL=https://models.github.ai/inference/chat/completions
# LLM_MODEL=gpt-4o-mini

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AWS (for S3 resume storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=skillgap-resumes

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Vector Store
VECTOR_STORE_TYPE=chroma
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=skillgap-titles
CHROMA_PERSIST_DIR=./chroma_db

# MLflow / Dagshub
MLFLOW_TRACKING_URI=https://dagshub.com/your-username/your-repo.mlflow
MLFLOW_TRACKING_USERNAME=your-username
MLFLOW_TRACKING_PASSWORD=your-password
MLFLOW_MODEL_NAME=skillgap-embedder

# Feature Flags
USE_SKILL_EXPANSION=true
